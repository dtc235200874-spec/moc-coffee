{
  // Cấu hình chuẩn cho Cloudflare Pages (moc-coffee.pages.dev)
  "name": "moc-coffee",
  "compatibility_date": "2025-02-14",
  "pages_build_output_dir": "./dist",
  // Tích hợp trực tiếp Cloudflare Workers AI (https://dash.cloudflare.com/.../ai/models)
  "ai": {
    "binding": "AI"
  },
  // Vector Database Cloudflare Vectorize
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "moc-coffee-vectors"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "DEFAULT_SHIPPING_FEE": "30000",
    "FREE_SHIPPING_THRESHOLD": "500000",
    "CF_EMBEDDING_MODEL": "@cf/baai/bge-m3",
    "CF_LLM_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "moc-coffee-db",
      "database_id": "5f8f3bde-67f5-46f8-94d5-745ea375393b"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "7f692b14a6fa44faa10e33657edaf6f3"
    }
  ]
}
